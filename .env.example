ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://barberpixelmango:change-me@localhost:5432/barberpixelmango
TEST_DATABASE_URL=postgresql+asyncpg://barberpixelmango:change-me@localhost:5432/barberpixelmango_test
CORS_ORIGINS=["http://localhost:3000"]

AUTH_SECRET_KEY=change-me-at-least-32-bytes-long-random-string
OTP_HMAC_SECRET=change-me-another-32-bytes-long-random-string

SCHEDULER_ENABLED=true

RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_AUTH=10/minute

EMAIL_BACKEND=console
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=change-me@smtp-brevo.com
SMTP_PASS=change-me
SMTP_FROM=BarberPixelMango <no-reply@example.com>
SMTP_TIMEOUT_SECONDS=10
